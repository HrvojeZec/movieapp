{
  "name": "movieapp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26.13.0",
    "npm": ">=11.10.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@mantine/notifications": "^8.3.18",
    "aos": "^2.3.4",
    "bcryptjs": "^3.0.3",
    "dayjs": "^1.11.23",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.539.0",
    "mongoose": "^8.17.1",
    "next": "15.5.29",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-infinite-scroll-component": "^6.1.0",
    "sass": "^1.108.1",
    "stripe": "^23.1.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/eslintrc": "^3",
    "@types/aos": "^3.0.8",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^5"
  },
  "allowScripts": {
    "sharp": true,
    "unrs-resolver": true,
    "@parcel/watcher": true
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.10"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "license": "MIT"
}
