{
  "name": "movieapp",
  "version": "1.0.1",
  "private": true,
  "engines": {
    "node": ">=26.13.0",
    "npm": ">=11.10.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@mantine/core": "^9.8.0",
    "@mantine/hooks": "^9.8.0",
    "@mantine/notifications": "^9.8.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.41.0",
    "bcryptjs": "^3.0.3",
    "dayjs": "^1.11.23",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.73.0",
    "mongoose": "^9.12.1",
    "motion": "^14.12.0",
    "next": "16.4.6",
    "nodemailer": "^10.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sass": "^1.108.1",
    "stripe": "^23.1.0",
    "zod": "^4.0.17",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.65.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "sharp": true,
    "unrs-resolver": true,
    "@parcel/watcher": true
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "license": "MIT"
}
