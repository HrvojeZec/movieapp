# Copy this file to .env.local and fill in the values.
# Never commit .env.local or any file with real secrets.

# --- App URL ---
# Absolute URL for links that leave the browser (emails, Stripe redirects, share previews).
# Optional: on Vercel it comes from the deployment (the production domain, or the branch URL on
# previews); locally it defaults to http://localhost:3000.
APP_URL=

# --- Database ---
# MongoDB connection string (e.g. MongoDB Atlas: Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Separate database for end-to-end tests (`npm run test:e2e`); tests create and delete users there.
# Usually the same cluster with another database name, e.g. .../movieapp-e2e?retryWrites=true&w=majority
E2E_MONGODB_URI=

# --- Authentication ---
# Secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# --- Stripe (test mode / sandbox: https://dashboard.stripe.com/test/apikeys) ---
# Prefer a restricted key (rk_test_...) with write access to Customers, Checkout Sessions,
# Subscriptions (cancel and resume) and Customer portal; a secret key (sk_test_...) also works.
STRIPE_SECRET_KEY=rk_test_...
# Signing secret of the webhook endpoint. The endpoint must use API version 2026-10-28.endive and
# listen to: checkout.session.completed, checkout.session.async_payment_succeeded,
# customer.subscription.created, customer.subscription.updated, customer.subscription.deleted,
# invoice.paid, invoice.payment_failed.
# Locally: `stripe listen --forward-to localhost:3000/api/stripe/webhook` prints a whsec_ secret.
STRIPE_WEBHOOK_SECRET=whsec_...
# Recurring price IDs of the subscription plans (Stripe Dashboard > Product catalog): a monthly
# and a yearly price on each product. Checkout answers 503 for an interval without a price.
STRIPE_PREMIUM_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_PREMIUM_YEARLY_PRICE_ID=price_...
STRIPE_PRO_YEARLY_PRICE_ID=price_...

# --- TMDB (https://www.themoviedb.org/settings/api) ---
# "API Key" (v3). Used only on the server; never prefix it with NEXT_PUBLIC_.
TMDB_API_KEY=

# --- Rate limiting (Upstash Redis, free plan: https://console.upstash.com) ---
# REST URL and token of an Upstash Redis database. Without them, limits are counted in memory:
# fine locally, in Docker and in tests, but on serverless hosting every instance counts separately.
# The Vercel Marketplace integration sets KV_REST_API_URL and KV_REST_API_TOKEN instead; both work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
